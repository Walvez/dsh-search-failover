{
  "name": "dsh-search-failover",
  "version": "0.2.0",
  "description": "Provider-level web search failover pool for DeepSeek Harness: rotate across 8 free/paid backends (Exa / Tavily / Serper / SerpApi / Jina / DuckDuckGo / SearXNG / Brave) with quota-aware circuit breaking, keeping the native web_search tool.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Walvez/dsh-search-failover.git"
  },
  "keywords": ["deepseek", "harness", "dsh", "dsh-plugin", "search", "failover", "circuit-breaker", "web-search"],
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "npm test"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/dsh-launch-environment": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-web": "^0.1.0-rc.6"
  },
  "dsh": { "bundle": { "patch": "cordis.patch.yml" } }
}
